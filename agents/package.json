{
  "name": "@tributary/agents",
  "private": true,
  "type": "module",
  "description": "Tributary offchain actors: x402 seller agent, demo buyer, underwriter agent, revenue keeper",
  "scripts": {
    "seller": "node --env-file=../.env src/seller.ts",
    "buyer": "node --env-file=../.env src/buyer.ts",
    "underwriter": "node --env-file=../.env src/underwriter.ts",
    "keeper": "node --env-file=../.env src/keeper.ts",
    "typecheck": "tsc --noEmit",
    "setup": "node --env-file=../.env src/setup.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "express": "^4.21.2",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
