# Tributary web env. Copy to .env (which is gitignored).
#
# With the three addresses set, the app reads Arc testnet on every route. The
# seeded simulator is not a fallback and is not the default: it runs only when
# the URL says ?demo=1, and when it does the dashboard header labels itself.

VITE_VAULT_ADDRESS=0xe13572efdfea23fe04f7cc81f98c083254a44ba8
VITE_REGISTRY_ADDRESS=0x897e3607b3dc5229ed4052ed09af7f6a70ec6c22
VITE_ROUTER_ADDRESS=0xF81EEE56be9Fd9d487A847f35CF4dfe563Eb778d

# Arc Testnet, chain id 5042002. The fallback is used when the primary RPC
# rate-limits or drops a request; viem promotes it per request, not per session.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
VITE_ARC_RPC_FALLBACK_URL=https://arc-testnet.drpc.org
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Force a mode regardless of the addresses above: "demo" | "chain".
# Leave blank. "demo" here would force the simulator on every visitor.
VITE_STREAM_MODE=

# Seed for the deterministic demo choreography. Overridable per URL with ?seed=
VITE_DEMO_SEED=tributary
